# Copy to .env.local and fill in from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for account deletion and the interaction cache. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: free key from https://open.fda.gov/apis/authentication/ raises openFDA rate limits
OPENFDA_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
